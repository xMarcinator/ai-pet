<Project Sdk="Microsoft.NET.Sdk">

  <!-- Draws the app icon with the pet's own renderer and writes the icon files the repo ships (see Program.cs).
       A tool, not part of the app: run it when the sprite or Sprout's palette changes and commit its output. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>IconGen</AssemblyName>
    <RootNamespace>AiPet</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Only the renderer's own files, linked rather than referencing AiPet.Core, so work elsewhere in Core can't break
       the tool. Paths.cs is there for Avatar.CustomDir; set AIPET_DATA_DIR to keep custom avatars out of the way. -->
  <ItemGroup>
    <Compile Include="..\..\src\AiPet.Core\Pet.cs" Link="Pet.cs" />
    <Compile Include="..\..\src\AiPet.Core\Avatar.cs" Link="Avatar.cs" />
    <Compile Include="..\..\src\AiPet.Core\Paths.cs" Link="Paths.cs" />
  </ItemGroup>

</Project>
