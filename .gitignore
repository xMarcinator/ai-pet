# Build output (build.sh, build.ps1)
artifacts/
# the release workflow's build folder (release.yml), when its steps are run locally
out/
Releases/
.idea/

# The plugin's hook binaries (native/<rid>/): the release workflow adds them to the release commit in the plugin
# repository. Only the launcher, native/aipet-hook.sh, is tracked here.
plugins/aipet/native/*/

# Old binaries and a source snapshot, kept locally only
legacy/

# Scratch and test output
scratch/
*.log
*.tmp
# Python's bytecode (the reference generators in avatars/reference)
__pycache__/
.claude/settings.local.json
# agent worktrees (Claude Code's); the skills in .claude/skills/ are tracked
.claude/worktrees/

# The Rust workspace's build output
rust/target/
# the research prototypes in rust/notes build on their own; their sources in src/bin are kept
rust/notes/prototypes/*/target/
rust/notes/prototypes/*/Cargo.lock
!rust/notes/prototypes/*/src/bin/
