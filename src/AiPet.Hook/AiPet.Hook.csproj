<Project Sdk="Microsoft.NET.Sdk">

  <!-- The per-agent hook: a tiny native exe (NativeAOT) that each client's plugin runs on every event. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>aipet-hook</AssemblyName>
    <RootNamespace>AiPet</RootNamespace>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Speed</OptimizationPreference>
    <!-- a run lasts well under a second, so a background GC thread gains nothing (and its write watch looks odd to sandboxes) -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\AiPet.Core\Paths.cs" Link="Paths.cs" />
    <Compile Include="..\AiPet.Core\Ipc.cs" Link="Ipc.cs" />
  </ItemGroup>

</Project>
