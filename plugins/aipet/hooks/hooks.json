        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/native/aipet-hook.sh\" --agent claude",
            "shell": "bash",
            "timeout": 5,
            "async": true
          }
        ]
      }
