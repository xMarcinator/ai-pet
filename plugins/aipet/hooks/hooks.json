{
  "description": "Report each Claude Code chat's status to the AiPet desktop pet, over HTTP (observe only: the pet never answers Claude).",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47615/hook/claude",
            "timeout": 2,
            "headers": {
              "X-AiPet-Entrypoint": "${CLAUDE_CODE_ENTRYPOINT}",
              "X-AiPet-Host-Session": "${CLAUDE_CODE_HOST_SESSION_ID}"
            },
            "allowedEnvVars": [
              "CLAUDE_CODE_ENTRYPOINT",
              "CLAUDE_CODE_HOST_SESSION_ID"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
