{
  "description": "Report each Claude Code chat's status to the AiPet desktop pet (observe only: the hook prints nothing and never answers Claude).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/native/aipet-hook.sh\" --agent claude",
            "shell": "bash",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/native/aipet-hook.sh\" --agent claude",
            "shell": "bash",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/native/aipet-hook.sh\" --agent claude",
            "shell": "bash",
            "timeout": 5,
            "async": true
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/native/aipet-hook.sh\" --agent claude",
            "shell": "bash",
            "timeout": 5,
            "async": true
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUseFailure": [
