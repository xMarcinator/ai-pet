{
  "description": "Report each Codex chat's status to the AiPet desktop pet, through its MCP server (observe only).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "aipet",
            "tool": "report_event",
            "timeout": 5,
            "input": {
              "agent": "codex",
              "event": {
                "session_id": "${session_id}",
                "hook_event_name": "${hook_event_name}",
                "cwd": "${cwd}",
                "model": "${model}",
                "transcript_path": "${transcript_path}",
                "source": "${source}"
              }
            }
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "aipet",
            "tool": "report_event",
            "timeout": 5,
            "input": {
              "agent": "codex",
              "event": {
                "session_id": "${session_id}",
                "hook_event_name": "${hook_event_name}",
                "cwd": "${cwd}",
                "model": "${model}",
                "transcript_path": "${transcript_path}",
                "turn_id": "${turn_id}",
                "prompt": "${prompt}"
              }
            }
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "aipet",
            "tool": "report_event",
            "timeout": 5,
            "input": {
              "agent": "codex",
              "event": {
                "session_id": "${session_id}",
                "hook_event_name": "${hook_event_name}",
                "cwd": "${cwd}",
                "model": "${model}",
                "transcript_path": "${transcript_path}",
                "turn_id": "${turn_id}",
                "tool_name": "${tool_name}",
                "tool_use_id": "${tool_use_id}",
                "tool_input": "${tool_input}"
              }
            }
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "aipet",
            "tool": "report_event",
            "timeout": 5,
            "input": {
              "agent": "codex",
              "event": {
                "session_id": "${session_id}",
                "hook_event_name": "${hook_event_name}",
                "cwd": "${cwd}",
                "model": "${model}",
                "transcript_path": "${transcript_path}",
                "turn_id": "${turn_id}",
                "tool_name": "${tool_name}",
                "tool_input": "${tool_input}"
              }
            }
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "aipet",
            "tool": "report_event",
            "timeout": 5,
            "input": {
              "agent": "codex",
              "event": {
                "session_id": "${session_id}",
                "hook_event_name": "${hook_event_name}",
                "cwd": "${cwd}",
                "model": "${model}",
                "transcript_path": "${transcript_path}",
                "turn_id": "${turn_id}",
                "tool_name": "${tool_name}",
                "tool_use_id": "${tool_use_id}",
                "tool_input": "${tool_input}"
              }
            }
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
