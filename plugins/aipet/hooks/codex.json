{
  "description": "Report each Codex chat's status to the AiPet desktop pet (observe only: the hook prints nothing).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$PLUGIN_ROOT/native/aipet-hook.sh\" --agent codex",
            "commandWindows": "& (Join-Path $env:PLUGIN_ROOT 'native\\win-x64\\aipet-hook.exe') --agent codex",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
