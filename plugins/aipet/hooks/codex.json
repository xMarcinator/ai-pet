      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "aipet",
            "tool": "report_event",
            "timeout": 5,
            "input": {
              "agent": "codex",
              "event": {
                "session_id": "${session_id}",
                "hook_event_name": "${hook_event_name}",
                "cwd": "${cwd}",
                "model": "${model}",
                "transcript_path": "${transcript_path}"
              }
            }
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "aipet",
            "tool": "report_event",
            "timeout": 5,
            "input": {
              "agent": "codex",
              "event": {
                "session_id": "${session_id}",
