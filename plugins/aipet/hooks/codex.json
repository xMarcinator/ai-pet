                "transcript_path": "${transcript_path}"
              }
            }
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "aipet",
            "tool": "report_event",
            "timeout": 5,
            "input": {
              "agent": "codex",
              "event": {
                "session_id": "${session_id}",
