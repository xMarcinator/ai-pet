<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows bench scripts' sampler (fnt-76 task 1): no packages, so it restores and builds offline. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>sampler</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- run as `dotnet sampler.dll`: no freshly built sampler.exe for Windows antivirus to hold -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
</Project>
